# ========================================================
# Swaava - Production Environment Configuration Reference
# ========================================================

# ========================================================
# 1. BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ========================================================

# Server & Runtime
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas / Cloud URI - MONGODB_URI also supported)
MONGODB_URL=mongodb+srv://db_user:db_password@cluster0.example.mongodb.net/swaava?retryWrites=true&w=majority

# Authentication & Security (generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_32_character_jwt_secret_key

# CORS Configuration (allowed frontend domains, comma-separated if multiple)
FRONTEND_URL=https://swaava.vercel.app

# Cloudinary (Media storage for food photos and kitchen avatars)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / Email Service (For password reset OTP delivery)
EMAIL=notifications@yourdomain.com
PASS=your_smtp_app_password


# ========================================================
# 2. FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ========================================================

# Backend API Base URL (e.g. https://maakhana.onrender.com or https://api.swaava.com)
# If empty when deploying on Vercel, requests use the same-domain /api rewrites in vercel.json
VITE_SERVER_URL=https://maakhana.onrender.com

# Firebase Client API Key (For Google Sign-In popup)
VITE_FIREBASE_APIKEY=your_firebase_web_api_key_here

# Geoapify Geocoding API Key (Optional: for city detection)
VITE_GEOAPIKEY=your_geoapify_api_key_here
