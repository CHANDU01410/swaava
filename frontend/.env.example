# ========================================================
# Swaava Frontend - Production Environment Variables
# ========================================================

# ── Backend API URL ──
# Base URL of the backend API (e.g., https://maakhana.onrender.com or https://api.swaava.com)
# If left empty when deploying on Vercel, requests use relative /api rewrites defined in vercel.json
VITE_SERVER_URL=https://maakhana.onrender.com

# ── Firebase Authentication (Google Sign-In) ──
# Google Firebase Web App API key for client-side OAuth
VITE_FIREBASE_APIKEY=your_firebase_web_api_key_here

# ── Geoapify (Location & Geocoding) ──
# Optional: API key for automatic customer city/location detection
VITE_GEOAPIKEY=your_geoapify_api_key_here
