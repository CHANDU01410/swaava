# ========================================================
# Swaava Backend - Production Environment Variables
# ========================================================

# ── Server & Runtime ──
# Port to bind (auto-assigned by Render/Railway/Heroku/AWS, default: 5000)
PORT=5000

# Runtime environment (development | production | test)
NODE_ENV=production

# ── Database ──
# MongoDB connection URI (Atlas or cloud hosted). MONGODB_URI is also supported.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://db_user:db_password@cluster0.example.mongodb.net/swaava?retryWrites=true&w=majority

# ── Authentication & Security ──
# Secret key used for signing and verifying JWT tokens (minimum 32 characters recommended)
# Generate via: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_32_character_jwt_secret_key

# ── CORS Configuration ──
# Allowed production frontend origin(s). Supports comma-separated list of origins.
# Example: https://swaava.vercel.app or https://swaava.com,https://www.swaava.com
FRONTEND_URL=https://swaava.vercel.app

# ── Cloudinary Media Storage ──
# Required for dish images, kitchen banners, and chef profile uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Email / SMTP (Password Reset OTP Delivery) ──
# Gmail or SMTP service credentials for delivering password reset verification codes
EMAIL=notifications@yourdomain.com
PASS=your_smtp_app_password
